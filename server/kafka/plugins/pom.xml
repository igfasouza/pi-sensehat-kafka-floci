<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.example.sensehat</groupId>
    <artifactId>tiered-storage-plugin-fetch</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <properties>
        <tiered.storage.version>2024.11.19</tiered.storage.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.aiven</groupId>
            <artifactId>tiered-storage-for-apache-kafka-core</artifactId>
            <version>${tiered.storage.version}</version>
        </dependency>
        <dependency>
            <groupId>io.aiven</groupId>
            <artifactId>tiered-storage-for-apache-kafka-s3</artifactId>
            <version>${tiered.storage.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.7.1</version>
                <executions>
                    <execution>
                        <id>copy-plugin-jars</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.basedir}/tiered-storage</outputDirectory>
                            <includeScope>runtime</includeScope>
                            <overWriteReleases>false</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
