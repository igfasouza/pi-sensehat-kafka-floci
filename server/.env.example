# If producer runs on this same Pi, localhost is fine.
# For producers on another machine, use the Pi LAN IP, e.g. 192.168.1.50
PI_HOST=localhost

# Recommended on Pi: point this to your USB SSD, e.g. /mnt/ssd/kafka-lab
DATA_ROOT=./data

# Pick which object-store backend to run under the Iceberg RSM.
# Only one at a time — comment the others.
COMPOSE_FILE=docker-compose.yml:docker-compose.s3.yml
#COMPOSE_FILE=docker-compose.yml:docker-compose.gcs.yml
#COMPOSE_FILE=docker-compose.yml:docker-compose.azure.yml
